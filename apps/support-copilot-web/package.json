{
  "name": "support-copilot-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:budget": "npm run build && node scripts/check-build-budget.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:node": "node --test e2e/mock-api.contract.test.mjs scripts/check-build-budget.test.mjs scripts/managed-child.test.mjs",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:contract": "VITE_CONTRACT_TEST_ENABLED=true VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://127.0.0.1:5173} vitest run src/integration/liveApiContract.test.ts --testTimeout=20000",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
