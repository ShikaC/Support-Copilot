# Operating system and editor files
.DS_Store
.idea/
.vscode/

# Local configuration and secrets
.env
.env.*
!.env.example

# Logs and generated archives
*.log
*.zip

# Test and tool caches
.coverage
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# Local runtime: workspace DB/logs + live experiment downloads/runs
# (quality-runs, business-benchmark-*, public-rag-*, quality-center, …)
.local/

# Local agent evidence ledger (Task scans, reviews); not published with the repo
.omo/

# Live / benchmark verification bulk under docs/verification.
# Keep human delivery notes (*.md), verify scripts (*.mjs), and patches on disk;
# ignore dumps that dominate Cursor/Git review (~300k+ lines): JSON results,
# corpus snapshots, per-trial payloads, embedded source trees, screenshots.
docs/verification/**/source/
docs/verification/**/run-*/
docs/verification/**/trials/
docs/verification/**/corpus/
docs/verification/quality-runs/
docs/verification/**/*.json
docs/verification/**/*.jsonl
docs/verification/**/*.png
docs/verification/**/*.jpg
docs/verification/**/*.jpeg
docs/verification/**/*.webp
docs/verification/**/*.snapshot
docs/verification/**/*.diff
docs/verification/**/*-before.py.txt
docs/verification/**/*-after.py.txt

# Pre-registered comparison protocols are review material, not bulk evidence
# output; keep them in Git even though sibling JSON is ignored above.
!docs/verification/development-comparison-2026-09-11/protocol.json
