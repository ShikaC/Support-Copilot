# Operating system and editor files
.DS_Store
.idea/
.vscode/

# Local configuration and secrets
.env
.env.*
!.env.example

# Logs and generated archives
*.log
*.zip

# Test and tool caches
.coverage
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# Local runtime: workspace DB/logs + live experiment downloads/runs
# (quality-runs, business-benchmark-*, public-rag-*, quality-center, …)
.local/

# Local agent evidence ledger (Task scans, reviews); not published with the repo
.omo/

# Live / benchmark verification bulk under docs/verification.
# Keep human delivery notes (*.md), verify scripts (*.mjs), and patches on disk;
# ignore dumps that dominate Cursor/Git review (~300k+ lines): JSON results,
# corpus snapshots, per-trial payloads, embedded source trees, screenshots.
docs/verification/**/source/
docs/verification/**/run-*/
docs/verification/**/trials/
docs/verification/**/corpus/
docs/verification/quality-runs/
docs/verification/**/*.json
docs/verification/**/*.jsonl
docs/verification/**/*.png
docs/verification/**/*.jpg
docs/verification/**/*.jpeg
docs/verification/**/*.webp
docs/verification/**/*.snapshot
docs/verification/**/*.diff
docs/verification/**/*-before.py.txt
docs/verification/**/*-after.py.txt

# Pre-registered comparison protocols and provider checks are review material,
# not bulk evidence output; keep them in Git even though sibling JSON is ignored.
!docs/verification/development-comparison-2026-09-11/**

# Offline retrieval-eval reports are small, conclusion-level evidence used as a
# frozen comparison baseline; unrelated bulk artifacts stay ignored above.
!docs/verification/retrieval-eval-2026-09-11/**

# Retrieval-only baseline: results, plan and score report are the evidence.
# The 341KB query-vector dump is reproducible from the plan and stays ignored.
!docs/verification/retrieval-only-2026-09-17/**
docs/verification/retrieval-only-2026-09-17/query-vectors.json

# Expanded evaluation set and its retrieval run. Both are small, conclusion-level
# evidence; only the regenerable query vectors stay ignored.
!docs/verification/retrieval-cases-expanded-2026-09-18/**
!docs/verification/retrieval-expanded-2026-09-18/**
docs/verification/retrieval-expanded-2026-09-18/query-vectors.json

# Chunking-granularity experiment run. The 4.8MB corpus itself stays out of Git and is
# rebuilt by prepare-doc2dial.mjs; the slicing identity and build record are kept.
!docs/verification/chunking-1000-800-2026-09-18/**
docs/verification/chunking-1000-800-2026-09-18/query-vectors.json
